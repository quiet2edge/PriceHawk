{
  "title": "PriceHawk Input",
  "description": "Basic configuration for PriceHawk.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "monitoring": {
      "title": "Monitoring Configuration",
      "description": "Define reseller monitoring targets.",
      "type": "object",
      "properties": {
        "targets": {
          "title": "Targets",
          "description": "List of reseller websites to monitor.",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "targetId": {
                "title": "Target ID",
                "description": "Unique identifier for this monitoring target.",
                "type": "string"
              },
              "website": {
                "title": "Website",
                "description": "Primary domain of the reseller website.",
                "type": "string"
              }
            },
            "required": ["targetId", "website"]
          }
        }
      }
    }
  }
}